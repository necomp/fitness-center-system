@model IEnumerable<fitcensys.Models.Gym>

@{
    ViewData["Title"] = "Spor Salonları";
}

<div class="text-center mb-5">
    <h1 class="display-4 text-primary">Spor Salonlarımız</h1>
    <p class="lead">Size en yakın ve en uygun salonu keşfedin.</p>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-success"> + Yeni Salon Ekle</a>
    }
</div>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <img src="https://placehold.co/600x400/209CEE/ffffff?text=@item.Name" class="card-img-top" alt="@item.Name">

                <div class="card-body">
                    <h5 class="card-title fw-bold">@item.Name</h5>
                    <p class="card-text text-muted">
                        📍 @item.Address
                    </p>
                </div>
                <div class="card-footer bg-white border-top-0 d-grid gap-2">
                    <a asp-action="Details" asp-route-id="@item.GymID" class="btn btn-outline-primary">🔍 İncele / Randevu</a>

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="btn-group btn-group-sm">
                            <a asp-action="Edit" asp-route-id="@item.GymID" class="btn btn-warning">Düzenle</a>
                            <a asp-action="Delete" asp-route-id="@item.GymID" class="btn btn-danger">Sil</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>