@model fitcensys.Models.AIViewModel

@{
    ViewData["Title"] = "AI Akıllı Koç";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-transparent bg-clip-text bg-gradient" style="background: linear-gradient(to right, #667eea, #764ba2); -webkit-background-clip: text; color: transparent;">
            🤖 FitCensys AI Koç
        </h1>
        <p class="lead text-muted">Vücut ölçülerinizi analiz edelim ve hedefinize uygun yol haritasını çizelim.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-dark text-white p-3">
                    <h5 class="mb-0">⚙️ Hedef Belirle</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="GenerateAdvice" method="post">
                        <div class="mb-3">
                            <label class="small text-muted">Mevcut Verileriniz</label>
                            <div class="d-flex justify-content-between border rounded p-2 bg-light">
                                <span>📏 @(Model.Height ?? 0) cm</span>
                                <span>⚖️ @(Model.Weight ?? 0) kg</span>
                                <span>🎂 @Model.Age Yaş</span>
                            </div>
                            @if (Model.Height == null || Model.Weight == null)
                            {
                                <div class="text-danger small mt-1">
                                    * Lütfen önce Profil sayfasından boy/kilo girin.
                                    <a asp-controller="Profile" asp-action="Index">Profile Git</a>
                                </div>
                            }
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">🎯 Amacın Nedir?</label>
                            <select asp-for="SelectedGoal" class="form-select form-select-lg">
                                <option value="Kilo Vermek (Yağ Yakımı)">Kilo Vermek (Yağ Yakımı)</option>
                                <option value="Kas Kütlesi Kazanmak (Bulk)">İri Gözükmek / Bulk (Kas Kütlesi)</option>
                                <option value="Fit ve Çevik Olmak (Definasyon)">Parçalı ve Kaslı (Definasyon)</option>
                                <option value="Esneklik ve Sağlık">Esneklik ve Sağlık (Yoga/Pilates)</option>
                                <option value="Güç Kazanmak (Powerlifting)">Sadece Güç İstiyorum (Powerlifting)</option>
                            </select>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg" id="analyzeBtn">
                                ✨ Analiz Et & Tavsiye Al
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            @if (!string.IsNullOrEmpty(Model.AIResponse))
            {
                <div class="card shadow border-0 h-100" style="background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);">
                    <div class="card-body p-4 text-center">

                        <h4 class="fw-bold text-primary mb-3">🎯 Hedeflenen Fizik ve Tavsiyeler</h4>

                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="mb-4 shadow-sm rounded overflow-hidden" style="max-height: 400px;">
                                <img src="@Model.ImageUrl" alt="Hedef Fizik" class="img-fluid" style="object-fit: cover; width: 100%;" />
                            </div>
                            <small class="text-muted d-block mb-3">Yapay zeka tarafından hedefinize özel üretilmiştir.</small>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-4">Görsel şu an oluşturulamadı, ancak tavsiyeleriniz hazır.</div>
                        }

                        <hr />

                        <div class="text-start mt-4 bg-white p-4 rounded shadow-sm">
                            <h5 class="fw-bold mb-3">📋 Koçun Planı:</h5>
                            <div class="fs-5" style="white-space: pre-line; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
                                @Model.AIResponse
                            </div>
                        </div>

                        <div class="mt-4">
                            <a asp-controller="Appointments" asp-action="Create" class="btn btn-success btn-lg shadow">
                                📅 Bu Plana Uygun Randevu Al
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted p-5 border rounded bg-light" style="border-style: dashed !important;">
                    <div class="display-1 mb-3">📸</div>
                    <h4>Analiz Bekleniyor</h4>
                    <p class="text-center">Hedefinizi seçin. Yapay zeka hem tavsiye verecek hem de hedeflediğiniz vücut tipini görselleştirecek.</p>
                    <small class="text-danger mt-2">Not: Resim oluşturma işlemi 10-20 saniye sürebilir.</small>
                </div>
            }
        </div>
    </div>
</div>

<script>
    document.getElementById("analyzeBtn").addEventListener("click", function() {
        this.innerHTML = "⏳ Analiz Yapılıyor...";
        // this.disabled = true; // Form submit'i engellememesi için bunu kapalı tutuyorum, istersen JS ile submit edebilirsin.
    });
</script>