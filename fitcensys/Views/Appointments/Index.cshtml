@model IEnumerable<fitcensys.Models.Appointment>

@{
    ViewData["Title"] = User.IsInRole("Admin") ? "Tüm Randevu Talepleri" : "Randevularım";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark">
                @(User.IsInRole("Admin") ? "🛠️ Randevu Yönetimi (Tümü)" : "📋 Randevularım")
            </h2>
            <p class="text-muted">
                @(User.IsInRole("Admin") ? "Bekleyen randevuları onaylayın veya reddedin." : "Geçmiş ve gelecek antrenmanlarınız.")
            </p>
        </div>

        @if (!User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
                + Yeni Randevu Al
            </a>
        }
    </div>

    <div class="card shadow border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            @if (User.IsInRole("Admin"))
                            {
                                <th class="ps-4">Üye Bilgisi</th>
                            }
                            <th class="@(User.IsInRole("Admin") ? "" : "ps-4")">Eğitmen / Hizmet</th>
                            <th>Tarih & Saat</th>
                            <th>Durum</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderByDescending(x => x.AppointmentDate))
                        {
                            <tr>
                                @if (User.IsInRole("Admin"))
                                {
                                    <td class="ps-4">
                                        <div class="fw-bold">@(item.Member?.FirstName + " " + item.Member?.LastName)</div>
                                        <small class="text-muted">@item.Member?.Email</small>
                                    </td>
                                }

                                <td class="@(User.IsInRole("Admin") ? "" : "ps-4")">
                                    <div class="fw-bold">@item.Trainer?.FirstName @item.Trainer?.LastName</div>
                                    <small class="text-muted">@(item.GymService?.ServiceDefinition?.Name ?? "Silinmiş Hizmet")</small>
                                </td>
                                <td>
                                    <div>📅 @item.AppointmentDate.ToString("dd.MM.yyyy")</div>
                                    <small class="text-muted">🕒 @item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</small>
                                </td>
                                <td>
                                    @if (item.Status.ToString() == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">⏳ Onay Bekliyor</span>
                                    }
                                    else if (item.Status.ToString() == "Confirmed")
                                    {
                                        <span class="badge bg-success">✅ Onaylandı</span>
                                    }
                                    else // Cancelled
                                    {
                                        <span class="badge bg-danger">❌ İptal/Red</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        @if (item.Status.ToString() == "Pending")
                                        {
                                            <a asp-action="Approve" asp-route-id="@item.AppointmentID" class="btn btn-sm btn-success me-1">Onayla</a>
                                            <a asp-action="Reject" asp-route-id="@item.AppointmentID" class="btn btn-sm btn-danger me-1">Reddet</a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">İşlem Yapıldı</span>
                                        }
                                        <a asp-action="Delete" asp-route-id="@item.AppointmentID" class="btn btn-sm btn-outline-secondary ms-1">🗑️</a>
                                    }
                                    else
                                    {
                                        @if (item.Status.ToString() != "Cancelled")
                                        {
                                            <a asp-action="Cancel" asp-route-id="@item.AppointmentID"
                                               class="btn btn-sm btn-outline-danger"
                                               onclick="return confirm('Bu randevuyu iptal etmek istediğinize emin misiniz?');">
                                                🚫 İptal Et
                                            </a>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="6" class="text-center p-4">Kayıt bulunamadı.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>