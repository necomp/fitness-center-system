@model fitcensys.Models.Appointment

@{
    ViewData["Title"] = "Yeni Randevu";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white p-4">
                    <h3 class="mb-0">📅 Yeni Randevu Oluştur</h3>
                    <p class="mb-0 opacity-75">Antrenmanınızı planlayın, yerinizi ayırtın.</p>
                </div>
                <div class="card-body p-4">

                    <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
                        <span class="fs-4 me-3">ℹ️</span>
                        <div>
                            Randevu saatini seçerken <strong>salonun çalışma saatlerine</strong> ve <strong>eğitmenin vardiyasına</strong> dikkat etmeyi unutmayın.
                        </div>
                    </div>

                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="GymServiceID" class="form-label fw-bold">Hizmet Seçimi</label>
                                <select asp-for="GymServiceID" class="form-select form-select-lg" asp-items="ViewBag.GymServiceID">
                                    <option value="">-- Hizmet Seçiniz --</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="TrainerID" class="form-label fw-bold">Eğitmen Tercihi</label>
                                <select asp-for="TrainerID" class="form-select form-select-lg" asp-items="ViewBag.TrainerID">
                                    <option value="">-- Eğitmen Seçiniz --</option>
                                </select>
                            </div>

                            <div class="col-12"><hr class="my-4 text-muted"></div>

                            <div class="col-md-6">
                                <label asp-for="AppointmentDate" class="form-label fw-bold">Tarih</label>
                                <input asp-for="AppointmentDate" type="date" class="form-control form-control-lg" />
                                <span asp-validation-for="AppointmentDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="StartTime" class="form-label fw-bold">Başlangıç Saati</label>
                                <input asp-for="StartTime" type="time" class="form-control form-control-lg" />
                                <span asp-validation-for="StartTime" class="text-danger"></span>
                                <div class="form-text">Bitiş saati, hizmet süresine göre otomatik hesaplanır.</div>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-5">
                            <button type="submit" class="btn btn-success btn-lg shadow-sm">✅ Randevuyu Onayla</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">İptal / Listeye Dön</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}