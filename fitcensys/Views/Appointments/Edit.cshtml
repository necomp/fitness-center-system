@model fitcensys.Models.Appointment
@using fitcensys.Models

@{
    ViewData["Title"] = "Edit";
}

<h1>Randevuyu Düzenle</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="AppointmentID" />

            <input type="hidden" asp-for="MemberID" />
            <input type="hidden" asp-for="GymServiceID" />
            <input type="hidden" asp-for="CreatedDate" />
            <input type="hidden" asp-for="PriceSnapshot" />

            <div class="card mb-3 bg-light">
                <div class="card-body">
                    <h5 class="card-title">Değiştirilemez Bilgiler</h5>
                    <div class="form-group">
                        <label class="control-label">Üye</label>
                        <input type="text" class="form-control" value="@(Model.Member?.FirstName + " " + Model.Member?.LastName)" disabled />
                    </div>
                    <div class="form-group">
                        <label class="control-label">Hizmet</label>
                        <input type="text" class="form-control" value="@(Model.GymService?.ServiceDefinition?.Name)" disabled />
                    </div>
                    <div class="form-group">
                        <label class="control-label">Anlaşılan Fiyat</label>
                        <input type="text" class="form-control" value="@Model.PriceSnapshot ₺" disabled />
                    </div>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TrainerID" class="control-label">Eğitmen</label>
                <select asp-for="TrainerID" class="form-control" asp-items="ViewBag.TrainerID"></select>
                <span asp-validation-for="TrainerID" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="AppointmentDate" class="control-label">Tarih</label>
                <input asp-for="AppointmentDate" type="date" class="form-control" />
                <span asp-validation-for="AppointmentDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="StartTime" class="control-label">Başlangıç Saati</label>
                <input asp-for="StartTime" type="time" class="form-control" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EndTime" class="control-label">Bitiş Saati</label>
                <input asp-for="EndTime" type="time" class="form-control" />
                <span asp-validation-for="EndTime" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Status" class="control-label">Durum</label>
                <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<AppointmentStatus>()"></select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Değişiklikleri Kaydet" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}