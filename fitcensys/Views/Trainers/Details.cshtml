@model fitcensys.Models.Trainer

@{
    ViewData["Title"] = "Eğitmen Detayı";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow">
                <img src="https://placehold.co/400x400/FF5733/ffffff?text=@Model.FirstName" class="card-img-top" alt="Trainer Photo">
                <div class="card-body text-center">
                    <h3>@Model.FullName</h3>
                    <p class="text-muted">@Model.Gym?.Name</p> <span class="badge bg-info text-dark">@Model.Gender</span>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white">
                    <h5>📝 Biyografi</h5>
                </div>
                <div class="card-body">
                    <p>@(Model.Biography ?? "Eğitmen hakkında biyografi bilgisi girilmemiş.")</p>
                </div>
            </div>

            <div class="card shadow">
                <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">🥊 Uzmanlık Alanları</h5>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="TrainerServices" asp-action="Create" asp-route-trainerId="@Model.TrainerID" class="btn btn-sm btn-dark">
                            + Ekle
                        </a>
                    }
                </div>
                <div class="card-body">
                    @if (Model.TrainerServices.Any())
                    {
                        @foreach (var service in Model.TrainerServices)
                        {
                            <div class="d-inline-block me-2 mb-2">
                                <span class="badge bg-dark fs-6 p-2">
                                    @service.ServiceDefinition?.Name

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-controller="TrainerServices" asp-action="Delete" asp-route-id="@service.TrainerServiceID" class="text-danger ms-2 text-decoration-none fw-bold" title="Bu uzmanlığı kaldır">
                                            X
                                        </a>
                                    }
                                </span>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Uzmanlık alanı belirtilmemiş.</p>
                    }
                </div>
            </div>
            <div class="card shadow mt-4">
                <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">📅 Çalışma Saatleri (Vardiya)</h5>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="TrainerAvailabilities" asp-action="Create" asp-route-trainerId="@Model.TrainerID" class="btn btn-sm btn-light text-dark fw-bold">
                            + Vardiya Ekle
                        </a>
                    }
                </div>
                <div class="card-body">
                    @if (Model.Availabilities != null && Model.Availabilities.Any())
                    {
                        <ul class="list-group">
                            @foreach (var shift in Model.Availabilities.OrderBy(x => x.Day))
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span><strong>@shift.Day:</strong> @shift.StartTime - @shift.EndTime</span>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-controller="TrainerAvailabilities" asp-action="Delete" asp-route-id="@shift.TrainerAvailabilityID" class="text-danger fw-bold text-decoration-none">X</a>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">Henüz vardiya bilgisi girilmemiş.</p>
                    }
                </div>
            </div>

            <div class="mt-4 text-end">
                <a asp-controller="Gyms" asp-action="Details" asp-route-id="@Model.GymID" class="btn btn-secondary">Salona Dön</a>
                <a asp-controller="Appointments" asp-action="Create" class="btn btn-success">📅 Randevu Sayfasına Git</a>
            </div>
        </div>
    </div>
</div>