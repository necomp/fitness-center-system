@model IEnumerable<fitcensys.Models.TrainerService>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Trainer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ServiceDefinition)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Trainer.FirstName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ServiceDefinition.Name)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.TrainerServiceID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.TrainerServiceID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.TrainerServiceID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
